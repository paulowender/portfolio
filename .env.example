# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database Connection (for Prisma)
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
# NEXT_PUBLIC_PRODUCTION=true  # Uncomment for production build
# NEXT_PUBLIC_STAGING=true     # Uncomment for staging build

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id

# PWA Configuration
NEXT_PUBLIC_APP_NAME="Portfolio"
NEXT_PUBLIC_APP_DESCRIPTION="Portfolio e Gerenciamento de Projetos"

# Performance Settings
# ANALYZE=true  # Uncomment to enable bundle analysis during build

# NFS-e: somente homologação, certificado A1 no servidor
NFSE_OWNER_USER_ID=
NFSE_CERTIFICATE_PATH=
NFSE_CERTIFICATE_PASSWORD=

# Proteção do certificado enviado pela tela: 32 bytes aleatórios em Base64.
# Gere uma vez no servidor e preserve a chave nos backups (não usar NEXT_PUBLIC_).
NFSE_ENCRYPTION_KEY=
# Opcional: diretório privado persistente, fora de public/.
# NFSE_CERTIFICATE_STORE_DIR=/caminho/privado/nfse
